NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL (Supabase / Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/pharmabridge

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# JWT — must be at least 32 characters
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay — use test keys in dev
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set in Razorpay dashboard → Webhooks → Secret (leave blank to skip signature verification in dev)
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MSG91 (OTP)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id

# Firebase Admin SDK — base64-encode your serviceAccountKey.json:
#   base64 -i serviceAccountKey.json | tr -d '\n'
# Leave empty in dev if not using push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
