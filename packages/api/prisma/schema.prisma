generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PHARMACY_OWNER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_UPDATE
  PRESCRIPTION_STATUS
  APPOINTMENT_UPDATE
  SYSTEM
  PROMOTIONAL
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum DoctorSpecialty {
  GENERAL_PHYSICIAN
  CARDIOLOGIST
  DERMATOLOGIST
  ENDOCRINOLOGIST
  GASTROENTEROLOGIST
  NEUROLOGIST
  ONCOLOGIST
  OPHTHALMOLOGIST
  ORTHOPEDIST
  PEDIATRICIAN
  PSYCHIATRIST
  PULMONOLOGIST
  UROLOGIST
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ConsultationType {
  IN_PERSON
  VIDEO
  CHAT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PromoCardType {
  BANNER
  OFFER
  HIGHLIGHT
}

enum PromoTarget {
  CUSTOMER
  PHARMACY
  ALL
}

enum InventoryAction {
  STOCK_IN
  SALE
  ADJUSTMENT
  RETURN
}

// ─── User ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  phone          String    @unique
  name           String?
  email          String?   @unique
  role           UserRole  @default(CUSTOMER)
  consentGivenAt DateTime?
  fcmToken       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders        Order[]
  addresses     Address[]
  pharmacy      Pharmacy?
  prescriptions Prescription[]
  notifications Notification[]
  appointments  Appointment[]

  @@index([phone])
}

// ─── Pharmacy ─────────────────────────────────────────────────────────

model Pharmacy {
  id             String   @id @default(cuid())
  name           String
  licenseNumber  String   @unique
  logoUrl        String?
  phone          String
  address        Json
  lat            Float?
  lng            Float?
  deliveryRadius Float    @default(5)
  isApproved     Boolean  @default(false)
  isActive       Boolean  @default(true)
  openingHours   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId     String       @unique
  owner       User         @relation(fields: [ownerId], references: [id])
  medicines   Medicine[]
  orders      Order[]
  commissions Commission[]
  doctors     Doctor[]

  @@index([lat, lng])
}

// ─── Medicine ─────────────────────────────────────────────────────────

model Medicine {
  id                     String   @id @default(cuid())
  name                   String
  genericName            String?
  manufacturer           String
  mrp                    Float
  price                  Float
  discountPercent        Float    @default(0)
  gstRate                Float
  hsnCode                String
  isPrescriptionRequired Boolean  @default(false)
  unit                   String   @default("strip")
  imageUrl               String?
  stock                  Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id])
  orderItems     OrderItem[]
  inventoryLogs  InventoryLog[]

  @@index([pharmacyId])
  @@index([name])
}

// ─── Address ──────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  line1     String
  line2     String?
  city      String
  district  String?
  state     String
  pincode   String
  landmark  String?
  isDefault Boolean @default(false)

  userId String
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

// ─── Order ────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique @default(cuid())
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod
  razorpayOrderId   String?
  razorpayPaymentId String?
  subtotal          Float
  deliveryFee       Float         @default(0)
  totalAmount       Float
  prescriptionUrl   String?
  notes             String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  addressId  String
  address    Address  @relation(fields: [addressId], references: [id])

  items         OrderItem[]
  timeline      OrderTimeline[]
  prescriptions Prescription[]
  commission    Commission?

  @@index([customerId])
  @@index([pharmacyId])
  @@index([status])
  @@index([createdAt])
}

// ─── OrderItem ────────────────────────────────────────────────────────

model OrderItem {
  id           String @id @default(cuid())
  medicineName String
  quantity     Int
  unitPrice    Float
  totalPrice   Float

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([orderId])
}

// ─── OrderTimeline ────────────────────────────────────────────────────

model OrderTimeline {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ─── Prescription ─────────────────────────────────────────────────────

model Prescription {
  id        String             @id @default(cuid())
  imageUrl  String
  status    PrescriptionStatus @default(PENDING)
  note      String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  customerId String
  customer   User    @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?  @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([status])
}

// ─── InventoryLog ─────────────────────────────────────────────────────

model InventoryLog {
  id            String          @id @default(cuid())
  action        InventoryAction
  delta         Int
  previousStock Int
  newStock      Int
  note          String?
  createdAt     DateTime        @default(now())

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
  @@index([createdAt])
}

// ─── Notification ─────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── Commission ───────────────────────────────────────────────────────

model Commission {
  id        String           @id @default(cuid())
  rate      Float
  amount    Float
  status    CommissionStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
  @@index([status])
}

// ─── Doctor ───────────────────────────────────────────────────────────

model Doctor {
  id              String          @id @default(cuid())
  name            String
  registrationNo  String          @unique
  specialty       DoctorSpecialty
  qualifications  String
  experience      Int
  consultationFee Float           @default(0)
  bio             String?
  imageUrl        String?
  languages       String[]
  isActive        Boolean         @default(true)
  isVerified      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  pharmacyId   String
  pharmacy     Pharmacy             @relation(fields: [pharmacyId], references: [id])
  availability DoctorAvailability[]
  appointments Appointment[]

  @@index([pharmacyId])
  @@index([specialty])
  @@index([isVerified])
}

// ─── DoctorAvailability ───────────────────────────────────────────────

model DoctorAvailability {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  slotMins  Int       @default(15)
  maxSlots  Int
  isActive  Boolean   @default(true)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}

// ─── Appointment ──────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique
  appointmentDate   DateTime
  startTime         String
  endTime           String
  status            AppointmentStatus @default(PENDING)
  consultationType  ConsultationType
  symptoms          String?
  notes             String?
  prescriptionUrl   String?
  fee               Float             @default(0)
  paymentStatus     PaymentStatus     @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])
  doctorId   String
  doctor     Doctor @relation(fields: [doctorId], references: [id])

  @@index([customerId])
  @@index([doctorId])
  @@index([status])
  @@index([appointmentDate])
}

// ─── PromoCard ────────────────────────────────────────────────────────

model PromoCard {
  id           String        @id @default(cuid())
  title        String
  subtitle     String?
  badge        String?
  tags         String[]      @default([])
  imageUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  type         PromoCardType @default(BANNER)
  target       PromoTarget   @default(CUSTOMER)
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive, displayOrder])
  @@index([type])
  @@index([target])
}
